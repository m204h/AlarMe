<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Checked / Selected state: solid fill (Coastal Blue #447794) -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/coastal_blue"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/coastal_blue"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <!-- Unchecked state: outlined (Deep Coastal Blue #2D5B75), transparent fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="1dp" android:color="@color/deep_coastal_blue"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
</selector>
