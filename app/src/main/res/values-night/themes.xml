<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Dark). -->
    <style name="Theme.Alarmy" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/coastal_blue</item>
        <item name="colorPrimaryVariant">@color/deep_coastal_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/coastal_blue</item>
        <item name="colorSecondaryVariant">@color/deep_coastal_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Dark theme surfaces and background. -->
        <item name="android:windowBackground">@color/midnight</item>
        <item name="colorSurface">@color/midnight</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/ocean</item>
        <item name="cardBackgroundColor">@color/ocean</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialCardViewStyle">@style/Widget.Alarmy.CardView</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/midnight</item>
        <!-- Customize action bar overflow icon -->
        <item name="actionOverflowButtonStyle">@style/HamburgerOverflowButtonStyle</item>
    </style>

    <style name="Widget.Alarmy.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/ocean</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="HamburgerOverflowButtonStyle" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:src">@drawable/ic_hamburger</item>
        <item name="srcCompat">@drawable/ic_hamburger</item>
        <item name="android:tint">@android:color/white</item>
        <item name="tint">@android:color/white</item>
    </style>

    <style name="ThemeOverlay.Alarmy.Popup" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:textColorPrimary">@color/white</item>
    </style>
</resources>
