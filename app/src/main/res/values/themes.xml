<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Light). -->
    <style name="Theme.Alarmy" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/coastal_blue</item>
        <item name="colorPrimaryVariant">@color/deep_coastal_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/deep_coastal_blue</item>
        <item name="colorSecondaryVariant">@color/coastal_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Light theme surfaces and background. -->
        <item name="android:windowBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/midnight</item>
        <item name="colorSurfaceVariant">@color/selector_container_bg</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <!-- Primary and secondary text colors. -->
        <item name="android:textColorPrimary">@color/midnight</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialCardViewStyle">@style/Widget.Alarmy.CardView</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize action bar overflow icon -->
        <item name="actionOverflowButtonStyle">@style/HamburgerOverflowButtonStyle</item>
    </style>

    <style name="Widget.Alarmy.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="HamburgerOverflowButtonStyle" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:src">@drawable/ic_hamburger</item>
        <item name="srcCompat">@drawable/ic_hamburger</item>
        <item name="android:tint">@android:color/white</item>
        <item name="tint">@android:color/white</item>
    </style>

    <style name="WeekdayButtonStyle">
        <item name="android:background">@drawable/bg_weekday_toggle</item>
        <item name="android:textColor">@color/text_weekday_toggle</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="ThemeOverlay.Alarmy.Popup" parent="ThemeOverlay.AppCompat.Light" />
</resources>
